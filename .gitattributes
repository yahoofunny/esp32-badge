# Normalize line endings in the repository to LF, so shell scripts stay runnable
# under Git Bash. Windows-only batch files get CRLF on checkout.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.exe binary
*.bin binary
*.zip binary
*.pdf binary
system/assets_clawd_album.h linguist-generated=true
lib/badge_audio_i2s/** linguist-vendored=true -whitespace
